{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "galoregrowth-ai-stage",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
